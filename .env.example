# Copy to .env and adjust. All vars are prefixed LCCN_ (see predictor/config.py).

# --- Database ---
LCCN_MONGODB_URI=mongodb://localhost:27017
LCCN_DB_NAME=lccn_predictor

# --- LeetCode endpoints (rarely need changing) ---
LCCN_LEETCODE_BASE_US=https://leetcode.com
LCCN_LEETCODE_BASE_CN=https://leetcode.cn

# --- Crawler tuning ---
LCCN_RANKING_CONCURRENCY=8
LCCN_RATING_CONCURRENCY=8
# Users resolved per GraphQL request (aliased batch). ~40 is safe; this is the
# single biggest speed lever for full-contest predictions. Higher risks
# GraphQL query-complexity limits.
LCCN_RATING_BATCH_SIZE=40
LCCN_HTTP_RETRY=6
LCCN_HTTP_TIMEOUT_SECONDS=30
# Treat a cached user rating as fresh for this many hours (avoid refetching).
LCCN_RATING_CACHE_TTL_HOURS=12
# Browser TLS fingerprint curl_cffi impersonates. "chrome" tracks the newest
# supported target; pin a specific one (e.g. chrome136) only as an escape hatch
# if it ever starts collecting 403s.
LCCN_IMPERSONATE=chrome

# --- Politeness / anti-block ---
# Requests per second across the whole batch. This, not concurrency, is what
# bounds our request rate: when Cloudflare refuses, a 403 returns from the edge
# in ~20ms, so N concurrent slots become hundreds of requests per second.
LCCN_HTTP_RATE_LIMIT_PER_SECOND=4
LCCN_HTTP_BACKOFF_BASE_SECONDS=1
LCCN_HTTP_BACKOFF_CAP_SECONDS=30
# Consecutive 403/429 responses before the circuit breaker pauses every request,
# how long each pause lasts, and how many fruitless pauses before giving up.
# A Cloudflare IP-reputation block does not clear in a minute, so a short
# cooldown just spends the breaker's budget without waiting anything out.
LCCN_HTTP_BLOCK_THRESHOLD=12
LCCN_HTTP_BLOCK_COOLDOWN_SECONDS=300
LCCN_HTTP_MAX_COOLDOWNS=3

# --- Crawl completeness ---
# Extra slow passes over only the ranking pages that failed. These RESUME —
# each pass keeps every page already fetched — which is why patience belongs
# here rather than in a workflow retry that restarts the crawl from page 1.
LCCN_REPAIR_PASSES=2
# Wait between repair passes, distinct from the breaker's cooldown: that paces
# requests inside a pass, this waits out a block between them.
LCCN_REPAIR_PASS_COOLDOWN_SECONDS=600
# Fraction of expected ranking rows required to accept a crawl. Below this the
# prediction is refused instead of persisted — a truncated field produces wrong
# Elo numbers AND overwrites the previous good prediction for that contest.
LCCN_MIN_RANKING_COVERAGE=0.98
# Fraction of GraphQL rating batches allowed to fail before refusing. Failed
# lookups fall back to (1500, 0), fine for stragglers, fabricated for a crowd.
LCCN_MAX_FAILED_RATING_BATCHES=0.02

# --- API ---
# In production set this to your website's exact origin, e.g. https://your-site.com
LCCN_CORS_ORIGINS=*
# Secret that gates crawl-triggering endpoints (admin predict, refresh) via the
# X-API-Key header. Leave empty only for local dev. Generate: openssl rand -hex 24
LCCN_API_KEY=
# When false (recommended for public deploys), /predict serves cached results
# only and never starts a live crawl. Set true for local/testing convenience.
LCCN_PUBLIC_CRAWL_ENABLED=true
# Per-IP rate limit for public reads (requests/minute). 0 disables.
LCCN_RATE_LIMIT_PER_MINUTE=120

# --- Scheduler ---
# Optional rating-cache warm-up (keeps cold-starts fast on always-on hosting).
LCCN_SCHEDULER_ENABLED=false
LCCN_SCHEDULER_INTERVAL_MINUTES=360
# Optional in-process auto-predict of the latest finished contest. Best for
# always-on/paid hosting. On free tiers that sleep, leave false and use the
# GitHub Actions cron (.github/workflows/predict-cron.yml) instead.
LCCN_AUTO_PREDICT_ENABLED=false
LCCN_AUTO_PREDICT_INTERVAL_MINUTES=30
